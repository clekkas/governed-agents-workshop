{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "utilization.history",
  "type": "object",
  "required": ["patientId", "correlationId"],
  "properties": {
    "patientId": { "type": "string" },
    "correlationId": { "type": "string" },
    "lookbackDays": { "type": "integer", "minimum": 1, "maximum": 730, "default": 365 },
    "aggregateOnly": { "type": "boolean", "default": true }
  },
  "additionalProperties": false
}

