# Copy to terraform.tfvars and adjust. All values are optional (sensible defaults exist).

# subscription_id = "00000000-0000-0000-0000-000000000000"

name_prefix = "dtec"
location    = "swedencentral"

# Foundry model deployment
model_name     = "gpt-4o"
model_version  = "2024-11-20"
model_sku      = "GlobalStandard"
model_capacity = 30

# Container app scaling
app_min_replicas = 1
app_max_replicas = 3

# Azure AI Search SKU (basic or standard for managed identity scenarios)
search_sku = "basic"
# Search region — norwayeast (swedencentral lacks basic-SKU Search capacity).
search_location = "norwayeast"

# --- Durable Task Scheduler (DTS) HITL gate ---
# Off by default. Set enable_dts=true to provision the scheduler, task hub, data-plane
# role, and worker Container App. Requires: az provider register --namespace Microsoft.DurableTask
# Flip hitl_mode to "dts" only once enable_dts=true AND the service DtsGate integration is in place.
# enable_dts       = false
# hitl_mode        = "local"   # "local" | "dts"
# dts_taskhub_name = "discharge"
# dts_sku_name     = "Dedicated"
# dts_sku_capacity = 1
# hitl_sla_seconds = 86400

# container_image is set automatically by the deploy script after the image is
# built and pushed. Leave the default for the first apply.
# container_image = "acrdtec123456.azurecr.io/discharge-transition:latest"

# --- Hosted (remote) MCP server ---
# Off by default. Set enable_mcp_server=true (or run deploy.ps1 -EnableMcpServer) to deploy the
# governed clinical MCP server as an INTERNAL-ingress Container App (private to the environment/VNet)
# over the streamable-http transport. The agent then routes tool calls to it (USE_EXTERNAL_MCP +
# MCP_SERVER_URL). Local stdio (python mcp-server/server.py) keeps working regardless.
# enable_mcp_server   = false
# container_image_mcp = "acrdtec123456.azurecr.io/discharge-transition-mcp:latest"

# --- Work IQ (M365 work-context lane) ---
# Off by default. Set enable_workiq=true to advertise Work IQ to the app/agent as a SEPARATE lane
# from the clinical MCP server. Work IQ is Microsoft-hosted and consumed via Entra delegated/
# on-behalf-of at runtime — NO app-only secret is provisioned here. Confirm the endpoint/scopes for
# your tenant against Microsoft Learn (see docs/work-iq-overview.md).
# enable_workiq   = false
# workiq_endpoint = "https://workiq.svc.cloud.microsoft/"

tags = {
  workload    = "foundry-phase2"
  environment = "workshop"
  data        = "synthetic-only"
  managed_by  = "terraform"
}
