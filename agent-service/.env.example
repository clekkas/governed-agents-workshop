# Copy to .env and load before running the agent service to enable live Foundry calls.
# Requires: pip install -r requirements-foundry.txt  and  az login (DefaultAzureCredential).

# Option 1: full project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://kaiser-foundry-resource.services.ai.azure.com/api/projects/workshop-demo-project

# Option 2 (alternative): account + project (the client builds the endpoint)
# AZURE_AI_FOUNDRY_ACCOUNT=kaiser-foundry-resource
# AZURE_AI_FOUNDRY_PROJECT=workshop-demo-project

# Model deployment name in the Foundry project
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini

# Azure context (used by az login / DefaultAzureCredential)
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<your-tenant-id>
